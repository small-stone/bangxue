# Copy to `.env` (gitignored) before `docker compose up`.
# Do not put real secrets in the image or commit `.env`.

# --- Postgres (compose `db` service) ---
POSTGRES_USER=bangxue
POSTGRES_PASSWORD=bangxue
POSTGRES_DB=bangxue
# Host `db` is the compose service name (not localhost).
DATABASE_URL=postgresql://bangxue:bangxue@db:5432/bangxue

# --- Bailian / DashScope (required for real quiz generation) ---
bailian_api_key=
QUIZ_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_PROVIDER=bailian
EMBEDDING_DIMENSION=1024

# --- Optional ---
QUIZ_PAPER_TTL_DAYS=7
# GRADING_DISABLE_DEMO=1
WEB_PORT=80

# --- Langfuse (optional LLM observability; omit both keys to disable) ---
# Fail-open: missing keys or upload errors never block quiz / chat / grading.
# Keys: Langfuse project Settings -> API Keys. Regions e.g. jp/us/eu cloud.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=   # legacy alias; BASE_URL preferred

